# 复制为 .env 后按需修改。仓库里不放任何真实密钥。
# cp .env.example .env

# ---- 部署形态 A：本机/内网跑 MCP ----
MCP_PORT=9100
# 容器内监听地址必须是 0.0.0.0，否则宿主访问不到
MCP_HOST=0.0.0.0

# ---- 部署形态 B：接真实 KIMORE 数据（需自行下载，见 docs/DATA.md）----
# 宿主机上 Kimore/ 目录的绝对路径；不填则只用 fixtures 回放
KIMORE_DATA=

# ---- 接进 Nexent 时填的地址 ----
# 同机 Docker：http://mcp-kimore:9100/sse（用容器名）
# 同机宿主：http://host.docker.internal:9100/sse
# 局域网  ：http://<宿主机内网IP>:9100/sse
MCP_PUBLIC_URL=http://host.docker.internal:9100/sse

# ---- Nexent 自己的模型配置（填入平台即可，不要提交）----
# 例：OpenAI 兼容端点
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
