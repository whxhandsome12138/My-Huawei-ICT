kimore:feature_repetition_count_left a owl:NamedIndividual, kimore:Feature ;
    rdfs:label "左侧动作重复次数"@zh ;
    kimore:featureId "repetition_count_left" ;
    kimore:unit "count" ;
    kimore:evidenceLevel "derived_engineering" ;
    kimore:paperCitation "Capecci et al. 2019, KIMORE, p.1441 sII.D（聚合口径为本项目工程选择）" ;
    kimore:hasSourceLine "feat_extract_Ex2.m:60" ;
    kimore:aggregation "count" ;
    kimore:usesJoint "ShoulderLeft" , "HipLeft" ;
    kimore:verticalReferenceIndependent true ;
    kimore:version "1.0" ;
    rdfs:comment "峰计数按作者参数（height=mean、distance=⌊n/10⌋）；原先 6 对 5 的差异经复核源于右侧多取一次负号，与平台段处理无关。计数是非负量，不带符号约定。"@zh .
