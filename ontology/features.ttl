    kimore:verticalReferenceIndependent true ;
    kimore:hasSignConvention kimore:sign_left_negative ;
    kimore:version "1.0" ;
    rdfs:comment "MATLAB findpeaks 与 scipy find_peaks 在平台段不等价，v1 只用于『是否完成 5 次』二值判断。"@zh .
