kimore:feature_torso_tilt_left_excursion_up a owl:NamedIndividual, kimore:Feature ;
    rdfs:label "左侧躯干上向偏移"@zh ;
    kimore:featureId "torso_tilt_left_excursion_up" ;
    kimore:unit "degree" ;
    kimore:evidenceLevel "derived_engineering" ;
    kimore:paperCitation "Capecci et al. 2019, KIMORE, p.1441 sII.D（聚合口径为本项目工程选择）" ;
    kimore:hasSourceLine "feat_extract_Ex2.m:60,61,62" ;
    kimore:aggregation "max-of-diff" ;
    kimore:usesJoint "ShoulderLeft" , "HipLeft" ;
    kimore:verticalReferenceIndependent true ;
    kimore:version "1.0" ;
    rdfs:comment "max − median（相对自身中位）：整段平移同时抬高 max 与 median，差值不变，故与竖直轴偏置无关，非负量不带符号约定。"@zh .
