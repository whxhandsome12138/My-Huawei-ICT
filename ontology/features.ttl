    kimore:usesJoint "ShoulderLeft" , "ElbowLeft" , "WristLeft" ;
    kimore:verticalReferenceIndependent true ;
    kimore:version "1.0" ;
    rdfs:comment "余弦定理三点角，与相机朝向无关。"@zh .
