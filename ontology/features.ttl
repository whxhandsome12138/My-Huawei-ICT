kimore:feature_hand_distance_median a owl:NamedIndividual, kimore:Feature ;
    rdfs:label "双手间距中位数"@zh ;
    kimore:featureId "hand_distance_median" ;
    kimore:unit "source_length_unit" ;
    kimore:evidenceLevel "derived_engineering" ;
    kimore:paperCitation "Capecci et al. 2019, KIMORE, p.1441 sII.D（聚合口径为本项目工程选择）" ;
